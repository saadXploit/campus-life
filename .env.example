# =====================================================
# CAMPUS LIFE: settings template
# Copy this file to a new file named .env.local and fill in the values.
# NEVER put real secrets in .env.example, and never share .env.local.
# =====================================================

# Your site address. Use this while developing on your computer:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Supabase dashboard -> Project Settings -> API
# (These two start with NEXT_PUBLIC_ because the browser needs them. They are safe to expose.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server only. Never put NEXT_PUBLIC_ in front of this one.
# Found in the same Supabase API page, labelled "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# The OWNER's permanent numeric X account ID (NOT the @username).
# We will find it together in a later step. Leave empty until then.
# While empty, NOBODY can become OWNER (this is deliberate).
OWNER_X_USER_ID=

# NOTE: X and Google client IDs/secrets do NOT go in this file.
# Supabase handles the OAuth login, so you enter those inside the Supabase dashboard.
# Random secret that signs admin session cookies. Generate a new one per environment.
ADMIN_SESSION_SECRET=
